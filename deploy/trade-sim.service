[Unit]
Description=Vectorized Trade Simulator (Streamlit)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/apps/vectorized-trade-simulator
ExecStart=/opt/apps/vectorized-trade-simulator/venv/bin/streamlit run app.py \
    --server.port 8502 \
    --server.headless true \
    --server.baseUrlPath trade \
    --server.address 127.0.0.1
Restart=always
RestartSec=5
Environment=STREAMLIT_SERVER_ENABLE_CORS=false
Environment=STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

[Install]
WantedBy=multi-user.target
